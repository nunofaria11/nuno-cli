#!/usr/bin/env bash
# summary: rebase a stack of dependent branches, resolving what is mechanical
set -euo pipefail
. "${NU_LIB:?nu-rb must be run through the nu dispatcher}/common.sh"

ENGINE="$NU_LIB/stack_rebase.py"

usage() {
  cat <<'USAGE'
usage: nu rb [base] [branch ...] [options]
       nu rb <subcommand>

Rebases a stack of dependent branches onto its base, one rebase per branch in
the worktree that holds it, and resolves every conflict that has exactly one
sane answer: resolutions recorded by rerere, lockfiles, generated files, and
edits that touch disjoint lines. Anything that needs a judgement call stops the
run.

Name the stack once, bottom first, optionally led by its base:
  nu rb master id-1-a id-2-b
Every finished run records each branch's parent, so afterwards a bare `nu rb`
from any branch of the stack restacks all of it. Branches at the bottom that
were squash-merged into the base are dropped from the stack.

  -y, --yes            do not ask before rewriting
  -n, --dry-run        show the plan and check preconditions, change nothing
  --base <branch>      what the stack sits on (default: origin/<default branch>,
                       fetched first; a local trunk name means its origin copy)
  --old-tip <sha>      cut point below the lowest branch, when the plan's is wrong
  --no-fetch           do not fetch the base first
  --no-ticket-guard    replay commits tagged with another ticket anyway

subcommands:
  plan               print the stack and the exact rebases, change nothing
  report             re-print the conflicts of a paused run
  verify             range-diff every rewritten branch against its backup
  abort              abort the run and restore every branch and worktree
  cleanup            drop the backup refs and the run's state

Backups live in refs/stack-backup/<branch>, invisible to `git branch`. The
only config written is branch.<name>.nuParent and nuParentTip. The ticket guard
reads its pattern from `git config nu.rb.ticketPattern` (empty disables it).
USAGE
}

sub=run
assume_yes=${NU_ASSUME_YES:-0}
dry=0
args=()

while [ $# -gt 0 ]; do
  case "$1" in
    plan | report | verify | abort | cleanup) sub="$1" ;;
    run) sub=run ;;
    -y | --yes) assume_yes=1 ;;
    -n | --dry-run) dry=1 ;;
    --no-fetch | --no-ticket-guard) args+=("$1") ;;
    --base | --old-tip)
      [ $# -ge 2 ] || die "$1 needs a value"
      args+=("$1" "$2")
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*) die "unknown option '$1' (nu rb --help)" ;;
    *) args+=("$1") ;;
  esac
  shift
done

command -v python3 >/dev/null || die "python3 not found"
[ -f "$ENGINE" ] || die "engine missing: $ENGINE"

engine() { python3 "$ENGINE" "$@"; }

# Exit 10 is the engine asking for a decision, not a failure. Say what to do
# about it and pass the code on, so scripts and the agent can both branch on it.
paused_footer() {
  printf '\n'
  step "stopped for a decision"
  dim "resolve the files above, git add them, then: nu rb   (from any worktree)"
  dim "or hand it to an agent: /rebase"
}

case "$sub" in
  plan) exec python3 "$ENGINE" plan ${args[0]+"${args[@]}"} ;;
  report | verify | abort | cleanup)
    set +e
    engine "$sub" ${args[0]+"${args[@]}"}
    rc=$?
    set -e
    [ "$rc" = 10 ] && [ "$sub" = report ] && paused_footer
    exit "$rc"
    ;;
esac

if [ "$dry" = 1 ]; then
  exec python3 "$ENGINE" run --dry-run ${args[0]+"${args[@]}"}
fi

# A paused run resumes from any worktree: nothing is left to plan or confirm.
run_active() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ -f "$common/stack-rebase/active" ]
}

run_active && assume_yes=1

quiet=()
if [ "$assume_yes" != 1 ]; then
  set +e
  plan_out=$(engine plan ${args[0]+"${args[@]}"})
  rc=$?
  set -e
  [ "$rc" = 0 ] || exit "$rc"
  printf '%s\n' "$plan_out"
  # The confirmed plan is the one that runs: the base was fetched already.
  quiet=(--quiet --no-fetch)
  case "$plan_out" in
    *"nothing to do"*) ;;
    *)
      printf '\n'
      confirm "rewrite these branches?" || die "aborted"
      printf '\n'
      ;;
  esac
fi

set +e
engine run ${quiet[0]+"${quiet[@]}"} ${args[0]+"${args[@]}"}
rc=$?
set -e
[ "$rc" = 10 ] && paused_footer
exit "$rc"
